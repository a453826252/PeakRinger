<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:paddingHorizontal="10dp"

    >

    <ImageView
        android:layout_marginVertical="15dp"
        android:id="@+id/item_setting_icon"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/item_setting_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:textColor="@color/black"
        android:textSize="14sp"
        tools:text="设置" />

    <TextView
        android:layout_weight="1"
        android:id="@+id/item_setting_subtitle"
        android:layout_width="wrap_content"
        android:gravity="right|center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingHorizontal="10dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="5dp"
        android:textColor="@color/border_of_cancel_btn"
        android:textSize="12sp"
        tools:text="副标题" />

<!--    <androidx.appcompat.widget.SwitchCompat-->
<!--        android:focusable="false"-->
<!--        android:clickable="false"-->
<!--        android:id="@+id/item_setting_switch"-->
<!--        android:layout_width="40dp"-->
<!--        android:layout_height="20dp"-->
<!--        android:thumb="@drawable/switch_thumb"-->
<!--        android:visibility="gone"-->
<!--        app:track="@drawable/switch_track_style"-->
<!--        tools:visibility="visible" />-->

    <ImageView
        android:id="@+id/item_setting_end_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@mipmap/ic_right_arrow_gray" />
</LinearLayout>
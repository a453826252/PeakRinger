<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="15dp"
    android:paddingVertical="5dp">

    <ImageView
        android:id="@+id/item_permission_icon"
        android:layout_width="25dp"
        android:layout_height="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_permission_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toTopOf="@id/item_permission_subtitle"
        app:layout_constraintLeft_toRightOf="@id/item_permission_icon"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="联系人权限" />

    <TextView
        android:id="@+id/item_permission_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/border_of_cancel_btn"
        android:textSize="10sp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@id/item_permission_title"
        app:layout_constraintRight_toLeftOf="@id/item_permission_authorize"
        app:layout_constraintTop_toBottomOf="@id/item_permission_title"
        tools:text="联系人权限" />

    <TextView
        android:id="@+id/item_permission_authorize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_enable_select_stroke"
        android:elevation="5dp"
        android:paddingHorizontal="15dp"
        android:paddingVertical="7dp"
        android:text="@string/authorize"
        android:textColor="@drawable/color_selector_enable_gray_main_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
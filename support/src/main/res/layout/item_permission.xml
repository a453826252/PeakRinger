<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:paddingHorizontal="15dp"
    android:paddingVertical="5dp"
    android:layout_height="wrap_content">

    <ImageView
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/item_permission_icon"
        android:layout_width="25dp"
        android:layout_height="25dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@mipmap/ic_phonebook" />

    <TextView
        android:id="@+id/item_permission_title"
        android:layout_marginStart="15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/item_permission_subtitle"
        app:layout_constraintLeft_toRightOf="@id/item_permission_icon"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="联系人权限" />

    <TextView
        android:layout_marginTop="2dp"
        android:textSize="10sp"
        android:textColor="@color/border_of_cancel_btn"
        android:id="@+id/item_permission_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="@id/item_permission_title"
        app:layout_constraintTop_toBottomOf="@id/item_permission_title"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="联系人权限" />
    <TextView
        android:textColor="@color/white"
        android:backgroundTint="@color/main_color"
        android:paddingVertical="5dp"
        android:paddingHorizontal="15dp"
        android:background="@drawable/bg_pr_dialog_cancel_btn"
        android:text="@string/authorize"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>